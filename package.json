{
  "name": "carton-site",
  "version": "1.0.0",
  "description": "Rasta Pack static website generator",
  "scripts": {
    "test": "node test/run.js",
    "build": "node src/build.js",
    "build:drafts": "node src/build.js --drafts",
    "build:temp": "node src/build.js --noindex",
    "serve": "node scripts/serve.js",
    "check": "npm run build && npm test",
    "release": "node src/build.js --strict"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "marked": "^18.1.3",
    "node-html-parser": "^9.0.7",
    "sharp": "^0.35.5",
    "vazirmatn": "^33.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
